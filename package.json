{
  "name": "educational-digital-twin-lumbar",
  "version": "1.5.0",
  "private": true,
  "description": "Educational Digital Twin - Prototype 1.5 - fictional lumbar case EDT-LUM-DUMMY-001 (synthetic, formative, local only)",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --serve",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:browser": "node scripts/build.mjs && node --test tests/browser/*.test.mjs",
    "reference-session": "node --import tsx scripts/generate-reference-session.ts",
    "verify": "npm run typecheck && npm test && npm run test:browser && npm run reference-session"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
